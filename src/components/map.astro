---
import "maplibre-gl/dist/maplibre-gl.css";
import maplibreScriptUrl from "maplibre-gl/dist/maplibre-gl.js?url";
import {BASE} from '../consts.ts';
import MapPopupTemplate from '../components/MapPopup.astro';
---
<MapPopupTemplate />

<div id="map" data-base={BASE}></div>

<script src={maplibreScriptUrl} is:inline></script>

<script>
  const postsData = document.getElementById("coffee-posts-data");
  const posts = JSON.parse(postsData?.textContent ?? "[]");
  window.posts = posts;
  window.mapVisibilityReady = false;
  window.wishlistPlaces ??= [];

  const initMap = () => {
    const mapElement = document.getElementById("map");
    const maplibregl = window.maplibregl;
    if (!mapElement || !maplibregl) {
      console.error('MapLibre failed to load.');
      return;
    }
    const base = mapElement.dataset.base ?? "/";

    const map = new maplibregl.Map({
      container: "map",
      style: `${base}mapstyle.json`,
      attributionControl: true,
      center: [-118.37000311225792, 33.8519980151288],
      zoom: 9.5,
    });

    map.on('error', (event) => console.error('MapLibre error:', event.error));
    map.addControl(new maplibregl.NavigationControl());

    const features = posts.map((c) => ({
      type: "Feature",
      geometry: {
        type: "Point",
        coordinates: [c.data.coords[1], c.data.coords[0]],
      },
      properties: {
        name: c.data.title,
        id: c.id,
        heroimgsrc: c.data.heroImage?.src ?? '',
        city: c.data.city,
        description: c.data.description,
        url: `${base}posts/${c.id}/`,
      },
    }));

    map.on("load", () => {
      map.addSource('CoffeeCoordinates', {
        type: 'geojson',
        data: {
          type: 'FeatureCollection',
          features,
        },
      });

      map.addLayer({
        id: 'coffee-points',
        type: 'circle',
        source: 'CoffeeCoordinates',
        paint: {
          'circle-radius': 8,
          'circle-color': '#ae3c3c',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 2,
        },
      });

      const wishlistFeatures = (window.wishlistPlaces ?? []).map((place) => ({
        type: "Feature",
        geometry: {
          type: "Point",
          coordinates: [place.coords[1], place.coords[0]],
        },
        properties: {
          id: place.id,
          name: place.name,
          heroimgsrc: '',
          city: place.location,
          description: place.notes || 'On your wishlist',
          url: `https://www.google.com/maps/search/?api=1&query=${place.coords[0]},${place.coords[1]}`,
        },
      }));

      map.addSource('WishlistCoordinates', {
        type: 'geojson',
        data: {
          type: 'FeatureCollection',
          features: wishlistFeatures,
        },
      });

      map.addLayer({
        id: 'wishlist-points',
        type: 'circle',
        source: 'WishlistCoordinates',
        layout: {
          visibility: window.wishlistMapVisible ? 'visible' : 'none',
        },
        paint: {
          'circle-radius': 9,
          'circle-color': '#d17b27',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 2,
        },
      });

      window.setWishlistVisible = (visible) => {
        window.wishlistMapVisible = visible;
        if (map.getLayer('wishlist-points')) {
          map.setLayoutProperty('wishlist-points', 'visibility', visible ? 'visible' : 'none');
        }
      };
    });

    const popup = new maplibregl.Popup({
      closeButton: true,
      closeOnClick: true,
      maxWidth: 'min(420px, 48%)',
    });

    let hoveredID = null;

    const showPopupForFeature = (feature, isWishlistPlace = false) => {
      map.getCanvas().style.cursor = 'pointer';
      const template = document.querySelector('#map-popup-template');
      if (!template) return;

      const mappopupnode = template.content.cloneNode(true);
      if (isWishlistPlace) {
        mappopupnode.querySelector('.MapPopupClass').classList.add('wishlist-popup');
      }
      mappopupnode.querySelector('.Name').textContent = feature.properties.name;
      const image = mappopupnode.querySelector('.her0image');
      image.src = feature.properties.heroimgsrc;
      image.hidden = isWishlistPlace || !feature.properties.heroimgsrc;
      mappopupnode.querySelector('.city').textContent = feature.properties.city;
      mappopupnode.querySelector('.descr').textContent = feature.properties.description;
      const link = mappopupnode.querySelector('.url');
      link.href = feature.properties.url;
      if (isWishlistPlace) {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      }

      if (!isWishlistPlace) {
        hoveredID = feature.properties.id;
        const current = document.getElementById(hoveredID);
        current?.classList?.add('highlighted');

        if (typeof window.hoveredCoffeePoint === 'function') {
          window.hoveredCoffeePoint(hoveredID);
        }

        const list = document.querySelector('#featurecards ul');
        if (current && list) {
          list.insertBefore(current, list.firstChild);
        }
      }

      popup
        .setLngLat(feature.geometry.coordinates)
        .setDOMContent(mappopupnode)
        .setOffset([5, 0])
        .addTo(map);
    };

    map.on('mouseenter', 'coffee-points', (event) => {
      showPopupForFeature(event.features[0]);
    });

    map.on('mouseenter', 'wishlist-points', (event) => {
      showPopupForFeature(event.features[0], true);
    });

    map.on('mouseleave', 'coffee-points', () => {
      map.getCanvas().style.cursor = '';
      const current = document.getElementById(hoveredID);
      current?.classList?.remove('highlighted');
      const hoveredFeaturedCard = document.getElementById('hoveredmapelement-specialfeaturedcard');
      if (hoveredFeaturedCard) {
        hoveredFeaturedCard.style.display = 'none';
      }
    });

    map.on('mouseleave', 'wishlist-points', () => {
      map.getCanvas().style.cursor = '';
    });

    window.addEventListener('coffee-roamer:wishlist-changed', (event) => {
      const places = (event as CustomEvent).detail;
      const source = map.getSource('WishlistCoordinates');
      if (!Array.isArray(places) || !source) return;

      const features = places.map((place) => ({
        type: "Feature",
        geometry: {
          type: "Point",
          coordinates: [place.coords[1], place.coords[0]],
        },
        properties: {
          id: place.id,
          name: place.name,
          heroimgsrc: '',
          city: place.location,
          description: place.notes || 'On your wishlist',
          url: `https://www.google.com/maps/search/?api=1&query=${place.coords[0]},${place.coords[1]}`,
        },
      }));
      source.setData({
        type: 'FeatureCollection',
        features,
      });
    });

    const updateVisiblePosts = () => {
      const visiblefeatures = map.queryRenderedFeatures({ layers: ['coffee-points'] });
      const visibleIds = new Set(visiblefeatures.map((f) => f.properties.id));

      posts.forEach((post) => {
        post.data.mapvis = visibleIds.has(post.id);
      });
      window.mapVisibilityReady = true;

      if (typeof window.updateFeaturedCardsList === 'function') {
        window.updateFeaturedCardsList();
      }
    };

    let visibilityUpdateScheduled = false;
    const scheduleVisibilityUpdate = () => {
      if (visibilityUpdateScheduled) return;

      visibilityUpdateScheduled = true;
      map.once('idle', () => {
        visibilityUpdateScheduled = false;
        updateVisiblePosts();
      });
    };

    scheduleVisibilityUpdate();
    map.on('moveend', scheduleVisibilityUpdate);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMap, { once: true });
  } else {
    initMap();
  }
</script>

<style>
  #map {
    width: 100%;
    height: 100%;
    min-height: 420px;
  }
</style>