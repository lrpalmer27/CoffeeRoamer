---
import "maplibre-gl/dist/maplibre-gl.css";
import maplibreScriptUrl from "maplibre-gl/dist/maplibre-gl.js?url";
import {BASE} from '../consts.ts';
import MapPopupTemplate from '../components/MapPopup.astro';


import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<MapPopupTemplate />

<div id="map" data-base={BASE}></div>

<script src={maplibreScriptUrl} is:inline></script>

<script>
  const postsData = document.getElementById("coffee-posts-data");
  const posts = JSON.parse(postsData?.textContent ?? "[]");
  window.posts = posts;

  const initMap = () => {
    const mapElement = document.getElementById("map");
    const maplibregl = window.maplibregl;
    if (!mapElement || !maplibregl) {
      console.error('MapLibre failed to load.');
      return;
    }
    const base = mapElement.dataset.base ?? "/";

    const map = new maplibregl.Map({
      container: "map",
      style: `${base}mapstyle.json`,
      attributionControl: true,
      center: [-118.37000311225792, 33.8519980151288],
      zoom: 9.5,
    });

    map.on('error', (event) => console.error('MapLibre error:', event.error));
    map.addControl(new maplibregl.NavigationControl());

    const features = posts.map((c) => ({
      type: "Feature",
      geometry: {
        type: "Point",
        coordinates: [c.data.coords[1], c.data.coords[0]],
      },
      properties: {
        name: c.data.title,
        id: c.id,
        heroimgsrc: c.data.heroImage.src,
        city: c.data.city,
        description: c.data.description,
        url: `${base}posts/${c.id}/`,
      },
    }));

    map.on("load", () => {
      map.addSource('CoffeeCoordinates', {
        type: 'geojson',
        data: {
          type: 'FeatureCollection',
          features,
        },
      });

      map.addLayer({
        id: 'coffee-points',
        type: 'circle',
        source: 'CoffeeCoordinates',
        paint: {
          'circle-radius': 8,
          'circle-color': '#ae3c3c',
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 2,
        },
      });
    });

    const popup = new maplibregl.Popup({
      closeButton: true,
      closeOnClick: true,
      maxWidth: '40%',
      anchor: 'left',
    });

    let hoveredID = null;

    map.on('mouseenter', 'coffee-points', (e) => {
      map.getCanvas().style.cursor = 'pointer';
      const feature = e.features[0];
      const template = document.querySelector('#map-popup-template');
      if (!template) return;

      const mappopupnode = template.content.cloneNode(true);
      mappopupnode.querySelector('.Name').textContent = feature.properties.name;
      mappopupnode.querySelector('.her0image').src = feature.properties.heroimgsrc;
      mappopupnode.querySelector('.city').textContent = feature.properties.city;
      mappopupnode.querySelector('.descr').textContent = feature.properties.description;
      mappopupnode.querySelector('.url').href = feature.properties.url;

      hoveredID = feature.properties.id;
      const current = document.getElementById(hoveredID);
      current?.classList?.add('highlighted');

      if (typeof window.hoveredCoffeePoint === 'function') {
        window.hoveredCoffeePoint(hoveredID);
      }

      const list = document.querySelector('#featurecards ul');
      if (current && list) {
        list.insertBefore(current, list.firstChild);
      }

      popup
        .setLngLat(feature.geometry.coordinates)
        .setDOMContent(mappopupnode)
        .setOffset([5, 0])
        .addTo(map);
    });

    map.on('mouseleave', 'coffee-points', () => {
      map.getCanvas().style.cursor = '';
      const current = document.getElementById(hoveredID);
      current?.classList?.remove('highlighted');
      const hoveredFeaturedCard = document.getElementById('hoveredmapelement-specialfeaturedcard');
      if (hoveredFeaturedCard) {
        hoveredFeaturedCard.style.display = 'none';
      }
    });

    map.on('idle', () => {
      const visiblefeatures = map.queryRenderedFeatures({ layers: ['coffee-points'] });
      const idss = visiblefeatures.map((f) => f.properties.id);

      posts.forEach((post) => {
        post.data.mapvis = idss.includes(post.id);
      });

      if (typeof window.updateFeaturedCardsList === 'function') {
        window.updateFeaturedCardsList();
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMap, { once: true });
  } else {
    initMap();
  }
</script>

<style>
  #map {
    width: 100%;
    height: 100%;
    min-height: 420px;
  }
</style>