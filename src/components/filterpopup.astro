---
import {BASE} from '../consts.ts';

---

<div id="popupfiltermenu" aria-label="Map filters">
    <div class="filter-heading">
        <div>
            <p class="filter-eyebrow">PERSONALIZE YOUR VIEW</p>
            <h4>Filters</h4>
        </div>
        <span class="filter-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
                <path d="M4 5h16l-6.2 7.1v5.1l-3.6 1.8v-6.9L4 5z" />
            </svg>
        </span>
    </div>
    <div id="filterclickbuttons">
        <div id="CBLHS">
            <button id="VisOnMap" class="buttons active" type="button" aria-pressed="true">
                <span class="filter-symbol" aria-hidden="true">⌖</span>
                <span>Visible on map</span>
            </button>
            <button id="Rating" class="buttons" type="button" aria-pressed="false">
                <span class="filter-symbol" aria-hidden="true">★</span>
                <span>Overall rating</span>
            </button>
            <div class="filter-option" id="RatingOptions" hidden>
                <label for="minRating">Minimum overall rating</label>
                <select id="minRating">
                    <option value="100">5 stars</option>
                    <option value="90">4.5 stars</option>
                    <option value="80" selected>4 stars</option>
                    <option value="70">3.5 stars</option>
                    <option value="60">3 stars</option>
                    <option value="50">2.5 stars</option>
                    <option value="40">2 stars</option>
                    <option value="30">1.5 stars</option>
                    <option value="20">1 star</option>
                    <option value="10">0.5 stars</option>
                    <option value="0">Any rating</option>
                </select>
            </div>
        </div>
        <div id="CBRHS">
            <button id="Date" class="buttons" type="button" aria-pressed="false">
                <span class="filter-symbol" aria-hidden="true">◷</span>
                <span>Date visited</span>
            </button>
            <div class="filter-option date-options" id="DateOptions" hidden>
                <label for="visitDateFrom">From</label>
                <input id="visitDateFrom" type="date">
                <label for="visitDateThrough">Through</label>
                <input id="visitDateThrough" type="date">
            </div>
            <button id="WishlistPins" class="buttons" type="button" aria-pressed="false">
                <span class="filter-symbol" aria-hidden="true">♡</span>
                <span>Wishlist places</span>
            </button>
        </div>
    </div>
</div>


<style>
    #popupfiltermenu{
        position: absolute;
        top: 4.5rem;
        left: 0.5rem;
        width: min(440px, calc(100vw - 3rem));
        box-sizing: border-box;
        padding: 1.15em;
        border: 1px solid rgba(60, 60, 85, 0.14);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.9);
        box-shadow: var(--shadow-soft);
        backdrop-filter: blur(22px) saturate(1.35);
        -webkit-backdrop-filter: blur(22px) saturate(1.35);
        z-index: 1000; 
        display: none;
        gap: 1em;
        color: var(--gray-dark);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    #popupfiltermenu.visible {
        display: grid;
    }   

    .filter-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1em;
    }

    .filter-heading h4 {
        margin: 0;
        font-family: inherit;
        font-size: 1.2em;
        letter-spacing: -0.025em;
    }

    .filter-eyebrow {
        margin: 0 0 0.2em;
        color: #77716c;
        font-size: 0.58em;
        font-weight: 650;
        letter-spacing: 0.1em;
    }

    .filter-icon {
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        background: var(--surface-muted);
        color: var(--accent);
    }

    .filter-icon svg {
        width: 18px;
        height: 18px;
        fill: currentColor;
    }

    #filterclickbuttons {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9em;
        width: 100%;
    }

    #CBLHS,
    #CBRHS { 
        display: grid;
        align-content: start;
        gap: 0.55em;
        width: 100%;
    }

    #filterclickbuttons .buttons {
        justify-content: flex-start;
        min-height: 42px;
        padding: 0.55em 0.7em;
        text-align: left;
    }

    .filter-symbol {
        display: grid;
        flex: 0 0 25px;
        width: 25px;
        height: 25px;
        place-items: center;
        border-radius: 8px;
        background: rgba(138, 75, 56, 0.09);
        color: var(--accent);
        font-size: 1.05em;
    }

    .filter-option {
        display: grid;
        gap: 0.4em;
        width: 100%;
        padding: 0.35em 0.1em 0.15em;
        color: #6a6460;
        font-size: 0.72em;
        font-weight: 550;
        text-align: left;
    }

    .filter-option[hidden] {
        display: none;
    }

    .filter-option select,
    .filter-option input {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        min-height: 38px;
        padding: 0.45em 0.6em;
        border: 1px solid var(--border-subtle);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.8);
        color: var(--gray-dark);
        font: 500 0.95em -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .date-options {
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
    }

    @media (max-width: 480px) {
        #popupfiltermenu {
            left: 0;
            width: min(360px, calc(100vw - 2rem));
            padding: 1em;
        }

        #filterclickbuttons {
            gap: 0.65em;
        }

        #filterclickbuttons .buttons {
            gap: 0.35em;
            padding: 0.45em;
            font-size: 0.76em;
        }
    }

</style>