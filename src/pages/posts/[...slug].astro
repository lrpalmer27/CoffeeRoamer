---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const galleryPhotoUrls = import.meta.glob<ImageMetadata>(
		'/src/content/blog/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
		{ eager: true, import: 'default' },
	);
	const posts = await getCollection('blog');

	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			...post,
			galleryImages: Object.entries(galleryPhotoUrls)
				.filter(([path]) => {
					const heroFilename = post.data.heroImage?.src?.split('/').pop()?.split('.')[0];
					return path.startsWith(`/src/content/blog/${post.id}/`)
						&& path.split('/').pop()?.split('.')[0] !== heroFilename;
				})
				.sort(([pathA], [pathB]) => pathA.localeCompare(pathB, undefined, { numeric: true }))
				.map(([path, src]) => ({
					src,
					alt: path.split('/').pop()?.replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ') ?? 'Visit photo',
				})),
		},
	}));
}
type Props = CollectionEntry<'blog'> & { galleryImages: { src: string; alt: string }[] };

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} galleryImages={post.galleryImages}>
	<Content />
</BlogPost>
